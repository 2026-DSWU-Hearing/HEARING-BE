DATABASE_URL=postgresql+asyncpg://hearing:hearing@localhost:5433/hearing

# 인메모리-임시 저장소 (게스트 rate limit, refresh 토큰 블랙리스트). docker compose up -d redis
REDIS_URL=redis://localhost:6379/0

# 필수(기본값 없음, 32자 이상). 생성: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

GOOGLE_CLIENT_ID=

FCM_CREDENTIALS_PATH=firebase-credentials.json

# MVP 개발용 인증 우회 (운영 배포 전 false 로!)
DEV_AUTH_BYPASS=false
DEV_USER_ID=1

CORS_ORIGINS=["http://localhost:5173"]
