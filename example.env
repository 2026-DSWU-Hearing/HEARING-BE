# 배포 환경: dev | prod. prod 에서 DEV_AUTH_BYPASS=true 면 서버가 기동을 거부한다(fail-closed).
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://hearing:hearing@localhost:5433/hearing

# 필수(기본값 없음, 32자 이상). 생성: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

GOOGLE_CLIENT_ID=

FCM_CREDENTIALS_PATH=firebase-credentials.json

# MVP 개발용 인증 우회 — ENVIRONMENT=dev 에서만 허용(그 외엔 기동 실패)
DEV_AUTH_BYPASS=false
DEV_USER_ID=1

CORS_ORIGINS=["http://localhost:5173"]
